{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://compound-memory.local/schemas/run.schema.json",
  "title": "Version 2 lead-owned local run ledger",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "kind",
    "runId",
    "revision",
    "plan",
    "planFingerprint",
    "owner",
    "limits",
    "tasks",
    "gates",
    "integration",
    "next",
    "history",
    "created",
    "updated"
  ],
  "properties": {
    "schemaVersion": {
      "const": 2
    },
    "kind": {
      "const": "run"
    },
    "runId": {
      "$ref": "result.schema.json#/$defs/id"
    },
    "revision": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "plan": {
      "$ref": "plan.schema.json"
    },
    "planFingerprint": {
      "$ref": "#/$defs/hash"
    },
    "owner": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "version",
        "leaseUntil"
      ],
      "properties": {
        "id": {
          "$ref": "result.schema.json#/$defs/id"
        },
        "version": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "leaseUntil": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "retryLimit"
      ],
      "properties": {
        "retryLimit": {
          "type": "integer",
          "minimum": 1,
          "description": "Attempts per work or recheck cycle, including its first attempt. Only a verified stale accepted reopen resets this budget.",
          "maximum": 9007199254740991
        }
      }
    },
    "tasks": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/taskState"
      }
    },
    "gates": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/gateState"
      }
    },
    "integration": {
      "$ref": "#/$defs/integration"
    },
    "next": {
      "type": [
        "string",
        "null"
      ]
    },
    "history": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "kind",
          "at"
        ],
        "properties": {
          "kind": {
            "enum": [
              "worker-stopped",
              "owner-stopped",
              "reopened"
            ]
          },
          "at": {
            "type": "string",
            "format": "date-time"
          }
        }
      }
    },
    "created": {
      "type": "string",
      "format": "date-time"
    },
    "updated": {
      "type": "string",
      "format": "date-time"
    }
  },
  "$defs": {
    "hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "proofs": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^\\.verify/"
      }
    },
    "taskState": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "state",
        "attempt",
        "attemptsUsed",
        "assignment",
        "resultId",
        "resultFingerprint",
        "acceptanceDependencies",
        "reason"
      ],
      "properties": {
        "state": {
          "enum": [
            "planned",
            "ready",
            "claimed",
            "running",
            "blocked",
            "failed",
            "awaiting-review",
            "accepted",
            "cancelled"
          ]
        },
        "attempt": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991,
          "description": "Monotonic assignment attempt number. Never reset on retry or stale recheck."
        },
        "assignment": {
          "anyOf": [
            {
              "$ref": "assignment.schema.json"
            },
            {
              "type": "null"
            }
          ]
        },
        "resultId": {
          "anyOf": [
            {
              "$ref": "result.schema.json#/$defs/id"
            },
            {
              "type": "null"
            }
          ]
        },
        "resultFingerprint": {
          "anyOf": [
            {
              "$ref": "#/$defs/hash"
            },
            {
              "type": "null"
            }
          ]
        },
        "acceptanceDependencies": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "tasks",
                "gates"
              ],
              "properties": {
                "tasks": {
                  "type": "object",
                  "additionalProperties": {
                    "$ref": "#/$defs/hash"
                  }
                },
                "gates": {
                  "type": "object",
                  "additionalProperties": {
                    "$ref": "#/$defs/hash"
                  }
                }
              }
            }
          ]
        },
        "reason": {
          "type": [
            "string",
            "null"
          ]
        },
        "attemptsUsed": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991,
          "description": "Attempts used in the current work or recheck cycle. Reset only when reopening verified stale accepted work."
        }
      }
    },
    "gateState": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "state",
        "proofs",
        "context"
      ],
      "properties": {
        "state": {
          "const": "passed"
        },
        "proofs": {
          "$ref": "#/$defs/proofs"
        },
        "context": {
          "$ref": "result.schema.json#/$defs/context"
        }
      }
    },
    "integration": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "state",
        "proofs",
        "context"
      ],
      "properties": {
        "state": {
          "enum": [
            "pending",
            "passed",
            "failed"
          ]
        },
        "proofs": {
          "$ref": "#/$defs/proofs"
        },
        "context": {
          "anyOf": [
            {
              "$ref": "result.schema.json#/$defs/context"
            },
            {
              "type": "null"
            }
          ]
        },
        "reason": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
